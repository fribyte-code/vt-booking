# Production settings for compose.prod.yaml. Copy to .env, fill in, and keep it private
# (chmod 600). .env is never committed. See docs/DEPLOYMENT.md.

# Database password. Generate it, for example with `openssl rand -hex 32`, and set it before the
# first start: PostgreSQL stores it when it creates the database.
DB_PASSWORD=

# Where Nginx listens on the host, for the reverse proxy. 127.0.0.1 if the proxy runs on the same
# host; 0.0.0.0 (or a specific address) if it connects from elsewhere.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# The reverse proxy, as Nginx sees it (an address or CIDR range), and the header in which it sends
# the client's address (X-Forwarded-For or X-Real-IP). The default trusts no proxy, so every user
# would share the proxy's address for the login limits. See "Reverse proxy" in docs/DEPLOYMENT.md.
TRUSTED_PROXY=127.0.0.1
REAL_IP_HEADER=X-Forwarded-For

# Which CI-built images `make prod-pull` uses: `latest` (the newest build of main) or a commit SHA,
# to pin or roll back a version. `make prod-update` ignores the registry and builds locally.
IMAGE_TAG=latest
